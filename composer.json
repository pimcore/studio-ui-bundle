{
  "name": "pimcore/studio-ui-bundle",
  "license": "proprietary",
  "type": "pimcore-bundle",
  "description": "Pimcore Studio Ui Bundle",
  "config": {
    "discard-changes": true,
    "sort-packages": true,
    "preferred-install": {
      "pimcore/pimcore": "source",
      "*": "dist"
    },
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "pimcore/pimcore": "^2026.1",
    "pimcore/studio-backend-bundle": "^2026.1"
  },
  "require-dev": {
    "codeception/codeception": "^5.3.5",
    "codeception/module-asserts": "^2",
    "codeception/module-symfony": "^3.1.1",
    "phpstan/phpstan": "2.1.26",
    "phpstan/phpstan-symfony": "^2.0.2",
    "phpunit/phpunit": "^12.5.23 || ^13.1.7",
    "nyholm/psr7": "^1",
    "symfony/phpunit-bridge": "^6",
    "fakerphp/faker": "^1.23"
  },
  "conflict": {
    "pimcore/asset-metadata-class-definitions": "<3.0.1",
    "pimcore/quill-bundle": "<2.0.1"
  },
  "autoload": {
    "psr-4": {
      "Pimcore\\Bundle\\StudioUiBundle\\": "src/",
      "Pimcore\\": "core-extension/Pimcore/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pimcore\\Bundle\\StudioUiBundle\\Tests\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-2026.x": "2026.1.x-dev"
    },
    "pimcore": {
      "bundles": [
        "Pimcore\\Bundle\\StudioUiBundle\\PimcoreStudioUiBundle"
      ]
    }
  }
}
