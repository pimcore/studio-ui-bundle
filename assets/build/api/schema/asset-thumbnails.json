  "info": {
    "title": "Studio Backend API (slice: asset-thumbnails)",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/thumbnails/image": {
      "get": {
        "description": "Get collection of thumbnails for images. <br>\nThe thumbnails have to be defined as downloadable in order to be listed in the collection.\n",
        "operationId": "thumbnail_image_get_collection",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/Thumbnail"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "All downloadable image thumbnails"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get collection of thumbnails for images",
        "tags": [
          "Asset Thumbnails"
        ]
      }
    },
    "/pimcore-studio/api/thumbnails/image/config": {
      "post": {
        "description": "Create a new image thumbnail configuration with the specified name. <br>\nThe name must be unique and not already used by an existing thumbnail configuration.\n",
        "operationId": "thumbnail_image_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateThumbnailConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageThumbnailConfigDetail"
                }
              }
            },
            "description": "Created image thumbnail configuration as JSON"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>405 - Method Not Allowed<br>409 - Conflict<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Create a new image thumbnail configuration",
        "tags": [
          "Asset Thumbnails"
        ]
      }
    },
    "/pimcore-studio/api/thumbnails/image/config/{name}": {
      "get": {
        "description": "Get a specific image thumbnail configuration by its name including settings and media transformations.\n",
        "operationId": "thumbnail_image_get_by_name",
        "parameters": [
          {
            "description": "Image thumbnail configuration name",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageThumbnailConfigDetail"
                }
              }
            },
            "description": "Image thumbnail configuration as JSON"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get image thumbnail configuration",
        "tags": [
          "Asset Thumbnails"
        ]
      },
      "put": {
        "description": "Update a specific image thumbnail configuration by its name with new settings and media transformations.\n",
        "operationId": "thumbnail_image_update",
        "parameters": [
          {
            "description": "Image thumbnail configuration name",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateThumbnailConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageThumbnailConfigDetail"
                }
              }
            },
            "description": "Updated image thumbnail configuration as JSON"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Update image thumbnail configuration",
        "tags": [
          "Asset Thumbnails"
        ]
      },
      "delete": {
        "description": "Delete a specific image thumbnail configuration by its name.\n",
        "operationId": "thumbnail_image_delete",
        "parameters": [
          {
            "description": "Image thumbnail configuration name",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Image thumbnail configuration successfully deleted"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Delete image thumbnail configuration",
        "tags": [
          "Asset Thumbnails"
        ]
      }
    },
    "/pimcore-studio/api/thumbnails/image/tree": {
      "get": {
        "description": "Get image thumbnail configuration tree with thumbnails organized by groups. <br>\nThumbnails without a group are listed directly, while grouped thumbnails are organized into folder nodes.\n",
        "operationId": "thumbnail_image_get_tree",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "totalItems": {
                      "title": "totalItems",
                      "type": "integer"
                    },
                    "items": {
                      "items": {
                        "anyOf": [
                          {
                            "$ref": "#/components/schemas/ThumbnailConfigurationData"
                          },
                          {
                            "$ref": "#/components/schemas/ThumbnailConfigurationFolderData"
                          }
                        ]
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "totalItems",
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Image thumbnail configuration tree as JSON"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get image thumbnails tree",
        "tags": [
          "Asset Thumbnails"
        ]
      }
    },
