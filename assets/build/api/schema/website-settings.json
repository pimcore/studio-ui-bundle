  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/website-settings/add": {
      "post": {
        "description": "Add a new website setting with the provided name and type.\nThe following types are supported: <strong>text</strong>, <strong>document</strong>, <strong>asset</strong>, <strong>object</strong>, <strong>bool</strong>. <br>\n",
        "operationId": "website_settings_add",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebsiteSettingsAdd"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebsiteSetting"
                }
              }
            },
            "description": "Successfully added website setting"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Add a new website setting",
        "tags": [
          "Website Settings"
        ]
      }
    },
    "/pimcore-studio/api/website-settings": {
      "post": {
        "description": "Get all paginated website settings. <br> You can specify different filters in your request body. Example filters are: <br>\n<ul>\n  <li><strong>page</strong>: Used for offset calculation in pagination. To be used, needs to be defined together with the page.size</li>\n  <li><strong>pageSize</strong>: Used for limiting the result numbers per page. To be used, needs to be defined together with the page</li>\n  <li><strong>name</strong>: Filter by settings name</li>\n  <li><strong>type</strong>: Filter by settings type (text, document, asset, object, bool)</li>\n  <li><strong>creationDate</strong>: Filter by creation date (on, from, to)</li>\n</ul>\n",
        "operationId": "website_settings_get_collection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "filters": {
                    "properties": {
                      "page": {
                        "type": "integer"
                      },
                      "pageSize": {
                        "type": "integer"
                      },
                      "columnFilters": {
                        "type": "object"
                      },
                      "sortFilter": {
                        "type": "object"
                      },
                      "additionalSortFilters": {
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "totalItems": {
                      "title": "totalItems",
                      "type": "integer"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/WebsiteSetting"
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "totalItems",
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Paginated website settings with total count"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get paginated website settings",
        "tags": [
          "Website Settings"
        ]
      }
    },
    "/pimcore-studio/api/website-settings/{id}": {
      "put": {
        "description": "Update a website setting with the given <strong>{id}</strong>.\nThe <strong>{id}</strong> must be an ID of an existing website setting. <br>\nPlease note that <strong>all fields<strong> have to be provided.\n",
        "operationId": "website_settings_update",
        "parameters": [
          {
            "description": "Id of the website setting",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebsiteSettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebsiteSetting"
                }
              }
            },
            "description": "Successfully updated website setting"
          },
