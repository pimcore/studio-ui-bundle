                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Update a website setting",
        "tags": [
          "Website Settings"
        ]
      },
      "delete": {
        "description": "Delete a website setting with the given <strong>{id}</strong>.\nThe <strong>{id}</strong> must be an ID of an existing DocType. <br>\n",
        "operationId": "website_settings_delete",
        "parameters": [
          {
            "description": "Id of the website setting",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
