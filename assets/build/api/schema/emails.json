  "paths": {
    "/pimcore-studio/api/emails/blocklist": {
      "get": {
        "description": "Get paginated E-Mail blocklist entries. <br>\nYou can use different query parameters to filter the E-Mail blocklist\n",
        "operationId": "email_blocklist_get_collection",
        "parameters": [
          {
            "description": "Page number",
            "in": "query",
            "name": "page",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Number of items per page",
            "in": "query",
            "name": "pageSize",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Email address to be filtered by",
            "in": "query",
            "name": "email",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "totalItems": {
                      "title": "totalItems",
                      "type": "integer"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/BlocklistEntry"
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "totalItems",
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Paginated E-Mail blocklist entries with total count as header param"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get paginated collection of blocklist entries",
        "tags": [
          "E-Mails"
        ]
      },
      "post": {
        "description": "Add an E-mail address to the blocklist. <br> The E-mail address has to be compliant with the PHP validate filter.\n",
        "operationId": "email_blocklist_add",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailAddressParameter"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully added E-mail address to blocklist"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>405 - Method Not Allowed<br>409 - Conflict<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Add an E-mail address to the blocklist",
        "tags": [
          "E-Mails"
        ]
      },
      "delete": {
        "description": "Delete an E-mail address from the blocklist with the given <strong>{email}</strong> <br> The E-mail address has to be present in the blocklist.\n",
        "operationId": "email_blocklist_delete",
        "parameters": [
          {
            "description": "Email address to be deleted from blocklist",
            "in": "query",
            "name": "email",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted E-mail address from blocklist"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Delete an E-mail address from the blocklist",
        "tags": [
          "E-Mails"
        ]
      }
    },
    "/pimcore-studio/api/emails": {
