  "info": {
    "title": "Studio Backend API (slice: service-users)",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/service-user": {
      "post": {
        "description": "Creates a service user, a machine identity with its own permissions, roles and workspaces, together with\nits confidential OAuth client (client_credentials). The response carries the client id and the client secret.\nThe secret is shown only in this response; only its hash is stored. A service user is never an administrator\nand has no password. Optionally names the users (responsibleUsers) and roles (responsibleRoles) who answer for it;\na service user cannot be one of them.\n",
        "operationId": "service_user_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceUserCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUserCredentials"
                }
              }
            },
            "description": "Client credentials of the new service user. The secret is shown only once."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>404 - Not Found<br>405 - Method Not Allowed<br>409 - Conflict<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>422 - Unprocessable Content"
          }
        },
        "summary": "Create a service user",
        "tags": [
          "Service User Management"
        ]
      }
    },
    "/pimcore-studio/api/service-user/from-user/{id}": {
      "post": {
        "description": "Creates a service user that takes over the permissions, roles, class and document type restrictions and\nworkspaces of the user with the given {id}. The user itself is not changed, and admin rights are never taken\nover. Only an administrator may create a service user from an administrator.\n",
        "operationId": "service_user_create_from_user",
        "parameters": [
          {
            "description": "Id of the user",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceUserCreateFromUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUserCredentials"
                }
              }
            },
            "description": "Client credentials of the new service user. The secret is shown only once."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>403 - Forbidden<br>404 - Not Found<br>405 - Method Not Allowed<br>409 - Conflict<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>422 - Unprocessable Content"
          }
        },
        "summary": "Create a service user from a user",
        "tags": [
          "Service User Management"
        ]
      }
    },
    "/pimcore-studio/api/service-user/{id}/deactivate": {
      "post": {
        "description": "Deactivates the service user with the given {id}. Its client credentials, OAuth tokens and MCP access tokens\nare refused from the next request on.\n",
        "operationId": "service_user_deactivate_by_id",
        "parameters": [
          {
            "description": "Id of the service user",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUser"
                }
              }
            },
            "description": "The deactivated service user"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Deactivate a service user",
        "tags": [
          "Service User Management"
        ]
      }
    },
    "/pimcore-studio/api/service-user/{id}": {
      "get": {
        "description": "Returns the service user with the given {id}, with its permissions, roles, workspaces and the id of its\nOAuth client. The client secret is never returned here.\n",
        "operationId": "service_user_get_by_id",
        "parameters": [
          {
            "description": "Id of the service user",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUser"
                }
              }
            },
            "description": "The service user"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get a service user",
        "tags": [
          "Service User Management"
        ]
      },
      "put": {
        "description": "Updates the contact email, permissions, roles, class and document type restrictions, workspaces and the\nresponsible users and roles (responsibleUsers, responsibleRoles; empty lists clear them) of the\nservice user with the given {id}. Name, password, admin rights and two-factor settings cannot be set; a\nrequest that contains any other field is refused.\n",
        "operationId": "service_user_update_by_id",
        "parameters": [
          {
            "description": "Id of the service user",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceUserUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUser"
                }
              }
            },
            "description": "The updated service user"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>400 - Bad Request<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>422 - Unprocessable Content"
          }
        },
        "summary": "Update a service user",
        "tags": [
          "Service User Management"
        ]
      },
      "delete": {
        "description": "Deletes the service user with the given {id}. Its OAuth client is deleted, its OAuth tokens and MCP access\ntokens are revoked, and its entries are removed from the access lists of every managed MCP server, so a later\nuser with the same name inherits nothing.\n",
        "operationId": "service_user_delete_by_id",
        "parameters": [
          {
            "description": "Id of the service user",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Service user deleted"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Delete a service user",
        "tags": [
          "Service User Management"
        ]
      }
    },
    "/pimcore-studio/api/service-users": {
      "get": {
        "description": "Lists all service users. Service users are not part of the user tree or the user collection.\n",
        "operationId": "service_user_get_collection",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "totalItems": {
                      "title": "totalItems",
                      "type": "integer"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/ServiceUser"
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "totalItems",
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "List of service users"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
