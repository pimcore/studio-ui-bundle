{
  "components": {
    "schemas": {
      "Authorization": {
        "properties": {
          "cookieLifetime": {
            "description": "Lifetime of the authorization cookie in seconds, renew it before it elapses",
            "type": "integer"
          }
        },
        "required": [
          "cookieLifetime"
        ],
        "title": "MercureAuthorization",
        "type": "object"
      },
      "DevError": {
        "description": "Error with details for developers",
        "properties": {
          "message": {
            "description": "Message",
            "type": "string"
          },
          "details": {
            "description": "Details",
            "type": "string"
          }
        },
        "required": [
          "message",
          "details"
        ],
        "title": "DevError",
        "type": "object"
      },
      "Error": {
        "description": "Bad credentials or missing token, bad request, method not allowed, etc.",
        "properties": {
          "message": {
            "description": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "Error",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Studio Backend API (slice: mercure)",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/mercure/auth": {
      "post": {
        "description": "Retrieve JWT token for Mercure hub as cookie",
        "operationId": "mercure_create_cookie",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Authorization"
                }
              }
            },
            "description": "Retrieve JWT token for Mercure hub as cookie"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Retrieve JWT token for Mercure hub as cookie",
        "tags": [
          "Mercure"
        ]
      }
    }
  }
}
