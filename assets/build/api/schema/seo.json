  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/bundle/seo/redirects/add": {
      "post": {
        "description": "Add a new redirect entry. <br> See the full description of request fields with the schema <strong>BundleSeoRedirectAdd</strong>\n",
        "operationId": "bundle_seo_redirect_add",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BundleSeoRedirectAdd"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BundleSeoRedirect"
                }
              }
            },
            "description": "New redirect data as JSON"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Add a new redirect",
        "tags": [
          "Bundle Seo"
        ]
      }
    },
    "/pimcore-studio/api/bundle/seo/redirects/cleanup": {
      "delete": {
        "description": "Cleanup all expired redirects. <br> This will delete all redirects which are expired based on the <strong>expiry</strong> field.\n",
        "operationId": "bundle_seo_redirect_cleanup",
        "responses": {
          "200": {
            "description": "Successfully cleaned up expired redirects"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Cleanup expired redirects",
        "tags": [
          "Bundle Seo"
        ]
      }
    },
    "/pimcore-studio/api/bundle/seo/redirects": {
      "post": {
        "description": "Get all paginated redirects entries. <br> You can specify different filters in your request body. Example filters are: <br>\n<ul>\n  <li><strong>page</strong>: Used for offset calculation in pagination. To be used, needs to be defined together with the page.size</li>\n  <li><strong>pageSize</strong>: Used for limiting the result numbers per page. To be used, needs to be defined together with the page</li>\n  <li><strong>url</strong>: Filter by redirect source URL</li>\n  <li><strong>type</strong>: Filter by redirect type (entire_uri, path_query, path, auto_create)</li>\n  <li><strong>date</strong>: Filter for example by expiry (on, from, to)</li>\n</ul>\n",
        "operationId": "bundle_seo_redirects_get_collection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "filters": {
                    "properties": {
                      "page": {
                        "type": "integer"
                      },
                      "pageSize": {
                        "type": "integer"
                      },
                      "columnFilters": {
                        "type": "object"
                      },
                      "sortFilter": {
                        "type": "object"
                      },
                      "additionalSortFilters": {
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "totalItems": {
                      "title": "totalItems",
                      "type": "integer"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/BundleSeoRedirect"
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "totalItems",
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Paginated redirects with total count as header param as JSON"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get all redirects",
        "tags": [
          "Bundle Seo"
        ]
      }
    },
    "/pimcore-studio/api/bundle/seo/redirects/{id}": {
      "put": {
        "description": "Update the redirect with the given <strong>{id}</strong>. The <strong>{id}</strong> must be an ID of existing redirect. <br>\nSee the full description of updatable fields with the schema <strong>BundleSeoRedirectUpdate</strong> <br>\nPlease note that <strong>all fields<strong> have to be provided.\n",
        "operationId": "bundle_seo_redirect_update_by_id",
        "parameters": [
          {
            "description": "Id of the redirect",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BundleSeoRedirectUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BundleSeoRedirect"
                }
              }
            },
            "description": "Successfully updated redirect"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Update a redirect by ID",
        "tags": [
          "Bundle Seo"
        ]
      },
      "delete": {
        "description": "Delete the redirect with the given <strong>{id}</strong>. <br> The <strong>{id}</strong> must be an ID of existing redirect.\n",
        "operationId": "bundle_seo_redirect_delete",
        "parameters": [
          {
            "description": "Id of the redirect",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted redirect"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Delete a redirect by ID",
        "tags": [
          "Bundle Seo"
        ]
      }
    },
