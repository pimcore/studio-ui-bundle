  "info": {
    "title": "Studio Backend API (slice: perspectives)",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/perspectives/configuration": {
      "post": {
        "description": "Create a new perspective with default values.\n",
        "operationId": "perspective_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddPerspectiveConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Id of the new perspective"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Create a new perspective",
        "tags": [
          "Perspectives"
        ]
      }
    },
    "/pimcore-studio/api/perspectives/configurations": {
      "get": {
        "description": "Listing of all available perspectives",
        "operationId": "perspective_get_config_collection",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "totalItems": {
                      "title": "totalItems",
                      "type": "integer"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/PerspectiveConfig"
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "totalItems",
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "List of perspective configurations"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Get all perspective configurations",
        "tags": [
          "Perspectives"
        ]
      }
    },
    "/pimcore-studio/api/perspectives/configuration/{perspectiveId}": {
      "get": {
        "description": "Get the perspective configuration with the given <strong>{perspectiveId}</strong>. <br> \nThe <strong>{perspectiveId}</strong> must be an ID of an existing perspective.\n",
        "operationId": "perspective_get_config_by_id",
        "parameters": [
          {
            "description": "Get perspective by matching Id",
            "in": "path",
            "name": "perspectiveId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerspectiveConfigDetail"
                }
              }
            },
            "description": "Perspective configuration data as JSON"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Get perspective configuration by ID",
        "tags": [
          "Perspectives"
        ]
      },
      "put": {
        "description": "Update the perspective configuration with the given <strong>{perspectiveId}</strong>. <br> \nThe <strong>{perspectiveId}</strong> must be an ID of an existing perspective. <br>\nPlease note that <strong>all configuration fields<strong> have to be provided.\n",
        "operationId": "perspective_update_config_by_id",
        "parameters": [
          {
            "description": "Update perspective by matching Id",
            "in": "path",
            "name": "perspectiveId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SavePerspectiveConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully updated perspective configuration"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Update widget configuration by id and type",
        "tags": [
          "Perspectives"
        ]
      },
      "delete": {
        "description": "Delete the perspective with the given <strong>{perspectiveId}</strong>. <br>\nThe <strong>{perspectiveId}</strong> must be an ID of an existing perspective.\n",
        "operationId": "perspective_delete",
        "parameters": [
          {
            "description": "Get perspective by matching Id",
            "in": "path",
            "name": "perspectiveId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted perspective"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Delete perspective by given id",
        "tags": [
          "Perspectives"
        ]
      }
    },
    "/pimcore-studio/api/perspectives/widgets/{widgetType}/configuration": {
      "post": {
        "description": "Create a new widget with default values based on the provided <strong>{widgetType}</strong>.\n<br> The widget type has to be registered via Symfony Configuration.\n<br> Please note that <strong>{name}</strong> has to be provided.\n",
