  "info": {
    "title": "Studio Backend API (slice: workflow)",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/workflows/details": {
      "get": {
        "description": "Get details of the element workflows based on the given <strong>{elementType}</strong> and <strong>{elementId}</strong>.\n",
        "operationId": "workflow_get_details",
        "parameters": [
          {
            "description": "ID of the element",
            "in": "query",
            "name": "elementId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Filter elements by matching element type.",
            "in": "query",
            "name": "elementType",
            "required": true,
            "schema": {
              "enum": [
                "asset",
                "document",
                "data-object"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/WorkflowDetails"
                      },
                      "title": "items",
                      "type": "array"
                    },
                    "layoutId": {
                      "title": "layoutId",
                      "type": "string"
                    }
                  },
                  "required": [
                    "items",
                    "layoutId"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Detail data of element workflows"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get all workflow details of an element",
        "tags": [
          "Workflows"
        ]
      }
    },
    "/pimcore-studio/api/workflows/elements/{elementType}": {
      "get": {
        "description": "Get a paginated list of elements that are currently in the given workflow and (optionally) state.\n",
        "operationId": "workflow_get_elements",
        "parameters": [
          {
            "description": "Filter elements by matching element type.",
            "in": "path",
            "name": "elementType",
            "required": true,
            "schema": {
              "enum": [
                "asset",
                "document",
                "data-object"
              ],
              "type": "string"
            }
          },
          {
            "description": "Workflow name",
            "in": "query",
            "name": "workflowName",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Workflow state / place name",
            "in": "query",
            "name": "stateName",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page number",
            "in": "query",
            "name": "page",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Number of items per page",
            "in": "query",
            "name": "pageSize",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "totalItems": {
                      "title": "totalItems",
                      "type": "integer"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/WorkflowElement"
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "totalItems",
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Paginated list of elements in the given workflow state"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>403 - Forbidden<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Get elements in a workflow state",
        "tags": [
          "Workflows"
        ]
      }
    },
    "/pimcore-studio/api/workflows/names": {
      "get": {
        "description": "Get all configured workflow names in the system.",
        "operationId": "workflow_get_names",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "type": "string"
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "List of all configured workflow names"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get all workflow names",
        "tags": [
          "Workflows"
        ]
      }
    },
    "/pimcore-studio/api/workflows/places": {
      "get": {
        "description": "Get all configured places for a specific workflow.",
        "operationId": "workflow_get_places",
        "parameters": [
          {
            "description": "Name of the workflow",
            "in": "query",
            "name": "workflowName",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "type": "string"
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "List of all configured place names for the workflow"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get all places for a workflow",
        "tags": [
          "Workflows"
        ]
      }
    },
    "/pimcore-studio/api/workflows/action": {
      "post": {
        "description": "Submit action based on the workflow name, action name and action type.",
        "operationId": "workflow_action_submit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "workflowName": {
                      "title": "workflowName",
                      "type": "string"
                    },
                    "actionName": {
                      "title": "actionName",
                      "type": "string"
                    },
                    "actionType": {
                      "title": "actionType",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Json encoded name of workflow, name and type of submitted action."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Submit workflow action",
        "tags": [
          "Workflows"
        ]
      }
    }
  }
}
