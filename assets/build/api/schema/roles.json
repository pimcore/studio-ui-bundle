          "id": {
            "description": "ID of the User",
            "type": "integer"
          },
          "name": {
            "description": "Name of Folder or Role",
            "type": [
              "string",
              "null"
            ]
          },
          "classes": {
            "description": "Classes the user is allows to see",
            "type": "object"
          },
          "parentId": {
            "description": "Parent ID",
