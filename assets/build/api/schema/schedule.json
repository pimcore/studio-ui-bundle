  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/schedules/{id}": {
      "delete": {
        "description": "Deletes a specific schedule based on the given <strong>{id}</strong>.\n",
        "operationId": "schedule_delete_by_id",
        "parameters": [
          {
            "description": "Id of the schedule",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted schedule"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Delete schedule with given id",
        "tags": [
          "Schedule"
        ]
      }
    },
    "/pimcore-studio/api/schedules/{elementType}/{id}": {
      "get": {
        "description": "Get all schedules for a specific element based on the given <strong>{elementType}</strong> and <strong>{id}</strong>. <br>\n",
        "operationId": "schedule_get_collection_for_element_by_type_and_id",
        "parameters": [
          {
            "description": "Filter elements by matching element type.",
            "in": "path",
            "name": "elementType",
            "required": true,
            "schema": {
              "enum": [
                "asset",
                "document",
                "data-object"
              ],
              "type": "string"
            }
          },
          {
            "description": "Id of the element",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/Schedule"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "List of schedules for element"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get schedules for an element",
        "tags": [
          "Schedule"
        ]
      },
      "put": {
        "description": "Update schedules for a specific element based on the given <strong>{elementType}</strong> and <strong>{id}</strong>. <br>\nSee the full description of updatable fields with the schema <strong>UpdateSchedule</strong>\n",
        "operationId": "schedule_update_for_element_by_type_and_id",
        "parameters": [
          {
            "description": "Filter elements by matching element type.",
            "in": "path",
            "name": "elementType",
            "required": true,
            "schema": {
              "enum": [
                "asset",
                "document",
                "data-object"
              ],
              "type": "string"
            }
          },
          {
            "description": "Id of the element",
