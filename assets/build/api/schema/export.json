{
  "components": {
    "schemas": {
      "AdvancedColumnConfig": {
        "properties": {
          "advancedColumns": {
            "description": "advancedColumns",
            "items": {
              "properties": {
                "key": {
                  "description": "Type of the column, e.g. \"simpleField\", \"relationField\", \"staticText\"",
                  "type": "string"
                },
                "config": {
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/RelationFieldConfig"
                      },
                      {
                        "$ref": "#/components/schemas/SimpleFieldConfig"
                      },
                      {
                        "$ref": "#/components/schemas/StaticTextConfig"
                      }
                    ]
                  },
                  "type": "array"
                }
              },
              "required": [
                "key",
                "config"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "transformers": {
            "description": "List if Transformers that should be applied",
            "items": {
              "$ref": "#/components/schemas/Transformer"
            },
            "type": "array"
          }
        },
        "required": [
          "advancedColumns"
        ],
        "title": "Advanced Column Config",
        "type": "object"
      },
      "Column": {
        "description": "Contains all data that is needed to get all the data for the column.",
        "properties": {
          "key": {
            "description": "Key",
            "type": "string"
          },
          "locale": {
            "description": "Locale",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "Type",
            "type": "string"
          },
          "group": {
            "description": "Group",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "config": {
            "description": "Config; a classification store column names its key by ID or identifier and may name a variant",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/components/schemas/AdvancedColumnConfig"
                }
              ]
            },
            "type": "array"
          },
          "width": {
            "description": "Width of the Column",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "type"
        ],
        "title": "Grid Column Request",
        "type": "object"
      },
      "DevError": {
        "description": "Error with details for developers",
        "properties": {
          "message": {
            "description": "Message",
            "type": "string"
          },
          "details": {
            "description": "Details",
            "type": "string"
          }
        },
        "required": [
          "message",
          "details"
        ],
        "title": "DevError",
        "type": "object"
      },
      "DownloadAvailability": {
        "properties": {
          "available": {
            "description": "Whether the exported file is still available for download",
            "type": "boolean"
          }
        },
        "required": [
          "available"
        ],
        "title": "Download Availability",
        "type": "object"
      },
      "Error": {
        "description": "Bad credentials or missing token, bad request, method not allowed, etc.",
        "properties": {
          "message": {
            "description": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "Error",
        "type": "object"
      },
      "ExportAllFilter": {
