                    },
                    "type": "array"
                  },
                  "columns": {
                    "items": {
                      "$ref": "#/components/schemas/Column"
                    },
                    "type": "array"
                  },
                  "config": {
                    "properties": {
                      "header": {
                        "enum": [
                          "id",
                          "custom_report_config",
