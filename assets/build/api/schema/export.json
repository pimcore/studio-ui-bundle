  "info": {
    "title": "Studio Backend API (slice: export)",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/export/download/csv/{jobRunId}/available": {
      "get": {
        "description": "Checks whether the CSV export for the given job run id is still available for download.\n",
        "operationId": "export_download_csv_available",
        "parameters": [
          {
            "description": "JobRunId of the JobRun",
            "in": "path",
            "name": "jobRunId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadAvailability"
                }
              }
            },
            "description": "Availability flag for the CSV export"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>403 - Forbidden<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Check CSV export availability for job run id",
        "tags": [
          "Export"
        ]
      }
    },
    "/pimcore-studio/api/export/download/csv/{jobRunId}": {
      "get": {
        "description": "Download the CSV file using the <strong>{jobRunId}</strong> returned by the create export endpoint. <br>\nFor folder exports, you must provide the ID of the corresponding child job run. <br>\nThe folder export first collects all elements and then creates a child job run to export them.\n",
        "operationId": "export_download_csv",
        "parameters": [
          {
            "description": "JobRunId of the JobRun",
            "in": "path",
            "name": "jobRunId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/csv": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "CSV File as attachment",
            "headers": {
              "Content-Disposition": {
                "description": "Content-Disposition header",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>403 - Forbidden<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Download CSV file for job run id",
        "tags": [
          "Export"
        ]
      },
      "delete": {
        "description": "Delete the CSV file with given <strong>{jobRunId}</strong> returned in the response of the create csv endpoint\n",
        "operationId": "export_delete_csv",
        "parameters": [
          {
            "description": "JobRunId of the JobRun",
            "in": "path",
            "name": "jobRunId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Delete CSV export file based on jobRunId",
        "tags": [
          "Export"
        ]
      }
    },
    "/pimcore-studio/api/export/csv": {
      "post": {
        "description": "Creating the CSV file for elements. <br> Parameters are: <ul>\n  <li><strong>elements</strong>: Array of element ids</li>\n  <li><strong>columns</strong>: Describes the columns that should be exported. Can be obtained via the grid endpoint</li>\n  <li><strong>config</strong>: Delimiter and header options</li>\n  <li><strong>elementType</strong>: Type of element that should be exported</li>\n</ul> \nDelimiter can be set to anything, but the default is a <strong>semicolon</strong> <br> \nHeader options are: <strong>no_header</strong>, <strong>title</strong> and <strong>name</strong><br>\nDownload has to be triggered separately via the csv download route with the <strong>{jobRunId}</strong> returned in the response\n",
        "operationId": "export_csv",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "elements": {
                    "items": {
                      "type": "integer"
                    },
                    "type": "array"
                  },
                  "columns": {
                    "items": {
                      "$ref": "#/components/schemas/Column"
                    },
                    "type": "array"
                  },
                  "config": {
                    "properties": {
                      "header": {
                        "enum": [
                          "id",
                          "custom_report_config",
                          "custom_report_to_export",
                          "element_class_id",
                          "elements_to_export",
                          "elements_to_rewrite_references",
                          "elements_to_tag",
                          "element_type",
                          "element_type_to_tag",
                          "element_type_to_rewrite_references",
                          "export_format",
                          "folder_to_export",
                          "folders_to_clone",
                          "grid_export_data",
                          "grid_export_data_info",
                          "config",
                          "columns",
                          "filters",
                          "delimiter",
                          "header",
                          "no_header",
                          "title",
                          "name",
                          "\r\n",
                          "array",
                          "int",
                          "string",
                          "bool",
                          "items_to_batch_delete",
                          "items_to_delete",
                          "element_type_to_batch_delete",
                          "items_to_restore",
                          "configuration_ids",
                          "configuration_type",
                          "new_owner_id"
                        ],
                        "type": "string"
                      },
                      "delimiter": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "elementType": {
                    "enum": [
                      "data-object",
                      "object",
                      "asset",
                      "document"
                    ],
                    "type": "string"
                  },
                  "classId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "jobRunId": {
                      "description": "ID of created jobRun",
                      "title": "jobRunId",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "jobRunId"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successfully created <strong>jobRun</strong> for csv export"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Creating CSV file for elements",
        "tags": [
          "Export"
        ]
      }
    },
    "/pimcore-studio/api/export/csv/folder/{id}": {
      "post": {
        "description": "Creating the CSV file for elements based on the folder. <br> \nParameters are: <ul>\n  <li><strong>columns</strong>: Describes the columns that should be exported. Can be obtained via the grid endpoint. For folders you can also use filters and sorting</li>\n  <li><strong>filters</strong>: Filter elements from folder based on the grid filter schema</li>\n  <li><strong>config</strong>: Delimiter and header options</li>\n</ul> \nDelimiter can be set to anything, but the default is a <strong>semicolon</strong> <br> \nHeader options are: <strong>no_header</strong>, <strong>title</strong> and <strong>name</strong><br>\nDownload has to be triggered separately via the csv download route with the <strong>{jobRunId}</strong> returned in the response\n",
        "operationId": "export_csv_folder",
        "parameters": [
          {
            "description": "Id of the folder",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "columns": {
                    "items": {
                      "$ref": "#/components/schemas/Column"
                    },
                    "type": "array"
                  },
                  "filters": {
                    "$ref": "#/components/schemas/ExportAllFilter"
                  },
                  "config": {
                    "properties": {
                      "header": {
                        "enum": [
                          "id",
                          "custom_report_config",
                          "custom_report_to_export",
                          "element_class_id",
                          "elements_to_export",
                          "elements_to_rewrite_references",
                          "elements_to_tag",
                          "element_type",
                          "element_type_to_tag",
                          "element_type_to_rewrite_references",
                          "export_format",
                          "folder_to_export",
                          "folders_to_clone",
                          "grid_export_data",
                          "grid_export_data_info",
                          "config",
                          "columns",
                          "filters",
                          "delimiter",
                          "header",
                          "no_header",
                          "title",
                          "name",
                          "\r\n",
                          "array",
                          "int",
                          "string",
                          "bool",
                          "items_to_batch_delete",
                          "items_to_delete",
                          "element_type_to_batch_delete",
                          "items_to_restore",
                          "configuration_ids",
                          "configuration_type",
                          "new_owner_id"
                        ],
                        "type": "string"
                      },
                      "delimiter": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "elementType": {
                    "enum": [
                      "data-object",
                      "object",
                      "asset",
                      "document"
                    ],
                    "type": "string"
                  },
                  "classId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "jobRunId": {
                      "description": "ID of created jobRun",
                      "title": "jobRunId",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "jobRunId"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successfully created <strong>jobRun</strong> for csv export"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Creating CSV file for elements based on folder",
        "tags": [
          "Export"
        ]
      }
    },
