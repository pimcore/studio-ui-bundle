            "type": "string"
          },
          "details": {
            "description": "Details",
            "type": "string"
          }
        },
        "required": [
          "message",
          "details"
        ],
        "title": "DevError",
        "type": "object"
      },
      "Error": {
        "description": "Bad credentials or missing token, bad request, method not allowed, etc.",
        "properties": {
          "message": {
            "description": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "Error",
        "type": "object"
      },
      "MaintenanceModeState": {
        "properties": {
          "additionalAttributes": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "object"
                }
              ]
            },
            "description": "AdditionalAttributes",
            "type": "object"
          },
          "active": {
            "description": "Whether maintenance mode is active",
            "type": "boolean"
          }
        },
        "required": [
          "active"
        ],
        "title": "Maintenance Mode State",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Studio Backend API (slice: maintenance-mode)",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/maintenance-mode": {
      "get": {
        "description": "Get whether the maintenance mode is currently active.",
        "operationId": "maintenance_mode_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaintenanceModeState"
                }
              }
            },
            "description": "Current maintenance mode state"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>403 - Forbidden<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get maintenance mode state",
        "tags": [
          "Maintenance Mode"
        ]
      },
      "post": {
        "description": "Activate the maintenance mode. Every request from another session is answered with HTTP 503 until the mode\nis deactivated; only the session that activated it keeps access. If that session ends (logout, expiry),\ndeactivate the mode with <strong>bin/console pimcore:maintenance-mode --disable</strong>.\n",
        "operationId": "maintenance_mode_activate",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaintenanceModeState"
                }
              }
            },
            "description": "Maintenance mode activated, the current session is exempt"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>403 - Forbidden<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Activate maintenance mode",
        "tags": [
          "Maintenance Mode"
        ]
      },
      "delete": {
        "description": "Deactivate the maintenance mode so that all sessions regain access.",
        "operationId": "maintenance_mode_deactivate",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaintenanceModeState"
                }
              }
            },
            "description": "Maintenance mode deactivated"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>403 - Forbidden<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Deactivate maintenance mode",
        "tags": [
          "Maintenance Mode"
        ]
      }
    }
  }
}
