                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Delete a specific tag",
        "tags": [
          "Tags"
        ]
      }
    },
    "/pimcore-studio/api/tags/assign/{elementType}/{id}/{tagId}": {
      "post": {
        "description": "Assign a specific tag based on the given <strong>{tagId}</strong> to an element based on <strong>{elementType}</strong> and <strong>{id}</strong>. <br>\nThe <strong>{id}</strong> must be an ID of an existing element of the provided <strong>{elementType}</strong>.\n",
        "operationId": "tag_assign_to_element",
        "parameters": [
          {
            "description": "Filter elements by matching element type.",
            "in": "path",
            "name": "elementType",
            "required": true,
            "schema": {
              "enum": [
                "asset",
                "document",
                "data-object"
              ],
              "type": "string"
            }
          },
          {
            "description": "Id of the element",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "TagId of the tag",
            "in": "path",
            "name": "tagId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Assign a tag to an element",
        "tags": [
          "Tags for Element"
        ]
      }
    },
    "/pimcore-studio/api/tags/batch/{operation}/{elementType}/{id}": {
      "post": {
        "description": "Batch assign/replace multiple tags of the given parent based on the <strong>{elementId}</strong> and <strong>{elementType}</strong> to the children. <br>\nOperation parameter <strong>{operation}</strong> must be one of the <strong>assign</strong or <strong>replace</strong>.\n",
        "operationId": "tag_batch_operation_to_elements_by_type_and_id",
        "parameters": [
          {
            "description": "Id of the element",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Filter elements by matching element type.",
            "in": "path",
            "name": "elementType",
            "required": true,
            "schema": {
              "enum": [
                "asset",
                "document",
                "data-object"
              ],
              "type": "string"
            }
          },
          {
            "description": "Execute operation based on provided type.",
            "in": "path",
            "name": "operation",
            "required": true,
            "schema": {
              "enum": [
                "assign",
                "replace"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "jobRunId": {
                      "description": "ID of created jobRun",
                      "title": "jobRunId",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "jobRunId"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successfully created jobRun for batch tag assignment/replacement"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>403 - Forbidden<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Batch assign/replace tags for children elements",
        "tags": [
          "Tags for Element"
        ]
      }
    },
    "/pimcore-studio/api/tags/{elementType}/{id}": {
      "get": {
        "description": "Get paginated tag collection for a specific element based on the given <strong>{elementType}</strong> and <strong>{id}</strong>\n",
        "operationId": "tag_get_collection_for_element_by_type_and_id",
        "parameters": [
          {
            "description": "Filter elements by matching element type.",
            "in": "path",
            "name": "elementType",
            "required": true,
            "schema": {
              "enum": [
                "asset",
                "document",
                "data-object"
              ],
              "type": "string"
            }
          },
          {
            "description": "Id of the element",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "totalItems": {
                      "title": "totalItems",
                      "type": "integer"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/Tag"
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "totalItems",
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Paginated tags for element"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get tags for an element",
        "tags": [
          "Tags for Element"
        ]
      }
    },
    "/pimcore-studio/api/tags/{elementType}/{id}/{tagId}": {
      "delete": {
        "description": "Unassign a specific tag based on the given <strong>{tagId}</strong> from an element based on <strong>{elementType}</strong> and <strong>{id}</strong>. <br>\nThe <strong>{id}</strong> must be an ID of an existing element of the provided <strong>{elementType}</strong>.\n",
        "operationId": "tag_unassign_from_element",
        "parameters": [
          {
            "description": "Filter elements by matching element type.",
            "in": "path",
            "name": "elementType",
            "required": true,
            "schema": {
              "enum": [
                "asset",
                "document",
