  "info": {
    "title": "Studio Backend API (slice: unit)",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/unit/quantity-value/units/collection": {
      "post": {
        "description": "Get a paginated and filterable collection of quantity value units.\n",
        "operationId": "unit_quantity_value_units_collection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "filters": {
                    "properties": {
                      "page": {
                        "type": "integer"
                      },
                      "pageSize": {
                        "type": "integer"
                      },
                      "columnFilters": {
                        "type": "object"
                      },
                      "sortFilter": {
                        "type": "object"
                      },
                      "additionalSortFilters": {
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "totalItems": {
                      "title": "totalItems",
                      "type": "integer"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/QuantityValueUnit"
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "totalItems",
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Paginated collection of quantity value units"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get quantity value unit collection",
        "tags": [
          "Units"
        ]
      }
    },
    "/pimcore-studio/api/unit/quantity-value/convert-all": {
      "get": {
        "description": "Convert quantity <strong>{value}</strong> from one unit to all other available units based on the given <strong>{fromUnitId}</strong>. <br>\nUnits have to have <strong>{fromUnitId}</strong> defined as base unit to be considered for conversion.\n",
        "operationId": "unit_quantity_value_convert_all",
        "parameters": [
          {
            "description": "Id of the unit to convert from",
            "in": "query",
            "name": "fromUnitId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Value to convert.",
            "in": "query",
            "name": "value",
            "required": true,
            "schema": {
              "format": "number",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConvertedQuantityValues"
                }
              }
            },
            "description": "Converted quantity value"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Convert quantity value from one unit to all other related units",
        "tags": [
          "Units"
        ]
      }
    },
    "/pimcore-studio/api/unit/quantity-value/convert": {
      "get": {
        "description": "Convert quantity <strong>{value}</strong> from one unit to another based on the given <strong>{fromUnitId}</strong> and <strong>{toUnitId}</strong>\n",
        "operationId": "unit_quantity_value_convert",
        "parameters": [
          {
            "description": "Id of the unit to convert from",
            "in": "query",
            "name": "fromUnitId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Id of the unit to convert to",
            "in": "query",
            "name": "toUnitId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Value to convert.",
            "in": "query",
            "name": "value",
            "required": true,
            "schema": {
              "format": "number",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Converted value",
                      "title": "data"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Converted quantity value"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Convert quantity value from one unit to another",
        "tags": [
          "Units"
        ]
      }
    },
    "/pimcore-studio/api/unit/quantity-value/units": {
      "post": {
        "description": "Create a new quantity value unit. The unit ID must be unique and not exceed 50 characters.\n",
        "operationId": "unit_quantity_value_units_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUnitParameters"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuantityValueUnit"
                }
              }
            },
            "description": "Created quantity value unit"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>400 - Bad Request<br>401 - Unauthorized<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>422 - Unprocessable Content"
          }
        },
        "summary": "Create a new quantity value unit",
        "tags": [
          "Units"
        ]
      }
    },
    "/pimcore-studio/api/unit/quantity-value/units/{id}": {
      "put": {
        "description": "Update an existing quantity value unit by its ID. <br>\nThe unit with the given ID must already exist. <br>\nPlease note that <strong>all fields<strong> have to be provided.\n",
        "operationId": "unit_quantity_value_units_update",
        "parameters": [
          {
            "description": "ID of the unit to update",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUnitParameters"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuantityValueUnit"
                }
              }
            },
            "description": "Updated quantity value unit"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Update a quantity value unit",
        "tags": [
          "Units"
        ]
      },
      "delete": {
        "description": "Delete a quantity value unit by its ID.\n",
        "operationId": "unit_quantity_value_units_delete",
        "parameters": [
          {
            "description": "ID of the unit to delete",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted quantity value unit"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Delete a quantity value unit",
        "tags": [
          "Units"
        ]
      }
    },
    "/pimcore-studio/api/unit/quantity-value/units/export": {
      "get": {
        "description": "Export all quantity value unit definitions as JSON.\n",
        "operationId": "unit_quantity_value_units_export",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "JSON export of quantity value units",
            "headers": {
              "Content-Disposition": {
                "description": "Content-Disposition header",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
