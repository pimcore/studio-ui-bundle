  "info": {
    "title": "Studio Backend API (slice: index-sync)",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/index-sync": {
      "post": {
        "description": "Starts a background job that updates the mappings of all search indices and queues every data object, asset and document for re-indexing. Existing indices are updated in place; only an index whose changed mapping cannot be applied to the documents it already holds (e.g. after a field type change) is recreated and refilled. Requires the system settings permission.",
        "operationId": "index_sync_start",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "jobRunId": {
                      "description": "ID of created jobRun",
                      "title": "jobRunId",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "jobRunId"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "A job run was created to synchronize the search index asynchronously"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>403 - Forbidden<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Synchronize the search index",
        "tags": [
          "Index Sync"
        ]
      }
    }
  }
}
