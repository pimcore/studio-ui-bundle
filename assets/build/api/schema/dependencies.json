  "info": {
    "title": "Studio Backend API (slice: dependencies)",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/pimcore-studio/api/dependencies/{elementType}/{id}": {
      "get": {
        "description": "Get paginated dependencies.\n        Pass dependency mode to get either all elements that depend on the provided element\n        or all dependencies for the provided element.",
        "operationId": "dependency_get_collection_by_element_type",
        "parameters": [
          {
            "description": "Filter elements by matching element type.",
            "in": "path",
            "name": "elementType",
            "required": true,
            "schema": {
              "enum": [
                "asset",
                "document",
                "data-object"
              ],
              "type": "string"
            }
          },
          {
            "description": "Id of the element",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Page number",
            "in": "query",
            "name": "page",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Number of items per page",
            "in": "query",
            "name": "pageSize",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Dependency mode",
            "in": "query",
            "name": "dependencyMode",
            "required": true,
            "schema": {
              "enum": [
                "required_by",
                "requires"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "totalItems": {
                      "title": "totalItems",
                      "type": "integer"
                    },
                    "items": {
                      "items": {
                        "anyOf": [
                          {
                            "$ref": "#/components/schemas/Dependency"
                          }
                        ]
                      },
                      "title": "items",
                      "type": "array"
                    }
                  },
                  "required": [
                    "totalItems",
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Paginated dependencies with total count as header param"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>403 - Forbidden<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content"
          }
        },
        "summary": "Get all dependencies for provided element.",
        "tags": [
          "Dependencies"
        ]
      }
    }
  }
}
