  "paths": {
    "/pimcore-studio/api/elements/{elementType}/batch-delete-info": {
      "post": {
        "description": "Get aggregated delete info for the given <strong>{elementType}</strong> and the provided list of <strong>ids</strong>. <br> Returns whether any of the selected elements has dependencies (child elements or references to it) and whether the whole selection can still use the recycle bin.\n",
        "operationId": "element_batch_delete_info",
        "parameters": [
          {
            "description": "Filter elements by matching element type.",
            "in": "path",
            "name": "elementType",
            "required": true,
            "schema": {
              "enum": [
                "asset",
                "document",
                "data-object"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "ids": {
                    "items": {
                      "type": "integer"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteInfo"
                }
              }
            },
            "description": "Batch delete info for the given elements"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>401 - Unauthorized<br>403 - Forbidden<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Get batch delete info for multiple elements by id list and element type",
        "tags": [
          "Elements"
        ]
      }
    },
    "/pimcore-studio/api/elements/{elementType}/delete/{id}": {
      "delete": {
        "description": "Deletes a specific element based on the given <strong>{elementType}</strong> and <strong>{id}</strong>. <br> The <strong>{id}</strong> must be an existing element of the provided <strong>{elementType}</strong>. <br> If element is a folder, all child elements will be deleted as well. Elements are moved into the Recycle Bin before deletion.\n",
        "operationId": "element_delete",
        "parameters": [
          {
            "description": "Id of the element",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Filter elements by matching element type.",
            "in": "path",
            "name": "elementType",
            "required": true,
            "schema": {
              "enum": [
                "asset",
                "document",
                "data-object"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted element"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "jobRunId": {
                      "description": "ID of created jobRun",
                      "title": "jobRunId",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "jobRunId"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successfully created jobRun for deleting element and its children"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/DevError"
                    }
                  ]
                }
              }
            },
            "description": "400 - Bad Request<br>400 - Bad Request<br>401 - Unauthorized<br>403 - Forbidden<br>404 - Not Found<br>405 - Method Not Allowed<br>415 - Unsupported Media Type<br>422 - Unprocessable Content<br>500 - Internal Server Error"
          }
        },
        "summary": "Delete a specific element and its children",
        "tags": [
          "Elements"
        ]
      }
    },
