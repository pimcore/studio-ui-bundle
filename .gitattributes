# The expanded frontend build is no longer committed (see .gitignore). Only the packaged
# archive build-dist/build-<id>.zip is tracked; it is reconstructed into public/build at
# runtime. The id is content-derived, so the filename varies — match it with a glob.
# Mark it generated, and binary + merge=ours so it is replaced wholesale on upstream merges
# instead of producing conflicts.
/build-dist/build-*.zip linguist-generated=true linguist-vendored=true
/build-dist/build-*.zip binary
/build-dist/build-*.zip merge=ours

# Per-slice API schema snapshots and the clients generated from them are
# machine-written (see assets/build/api/README.md). Collapse them in PR diffs;
# they are never merged by hand, always regenerated with `npm run api:sync`.
/assets/build/api/schema/*.json linguist-generated=true
/assets/js/**/*.gen.ts linguist-generated=true

# Exclude build/test files from archive to reduce ZIP size for composer dist download
/.github export-ignore
/tests export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.markdownlint.json export-ignore
/.php-cs-fixer.dist.php export-ignore
/CLA.md export-ignore
/CONTRIBUTING.md export-ignore
/codeception.dist.yml export-ignore
/phpstan* export-ignore
