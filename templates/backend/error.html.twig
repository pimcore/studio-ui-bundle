<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f5f5f5;
            margin: 0;
            padding: 4rem 2rem;
            text-align: center;
        }
        
        .error-container {
            max-width: 500px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px 0 rgba(0, 0, 0, 0.02);
            padding: 2.5rem;
            border: 1px solid #d9d9d9;
        }
        
        h1 {
            color: #ff4d4f;
            font-size: 1.5rem;
            font-weight: 500;
            margin-bottom: 1.25rem;
        }
        
        .message-content {
            color: rgba(0, 0, 0, 0.6);
            max-width: 100%;
            margin: 0 auto;
            line-height: 1.6;
        }
        
        .message-content b {
            color: rgba(0, 0, 0, 0.88);
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <h1>{{ title }}</h1>
        <div class="message-content">
            {{ message }}
        </div>
    </div>
</body>
</html>