{#
  App preloader — shown before JavaScript loads.
  To customise the loading screen in your bundle, override this template:
  templates/bundles/PimcoreStudioUIBundle/default/_preloader.html.twig

  @var branding array{brandColor: string|null, logoUrl: string|null}
#}
<style>
    #app-preloader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: #fff;
        overflow: hidden;
        transition: opacity 500ms ease;
        --pimcore-brand-color: #7a3ad4;
    }
    #app-preloader.app-preloader--fading { opacity: 0; }

    #app-preloader .background-figure {
        position: absolute;
        top: 50%;
        left: 50%;
        filter: blur(310px);
    }

    #app-preloader .background-figure--top-left {
        width: 1324px;
        height: 1324px;
        border-radius: 1324px;
        background: rgba(55, 217, 243, 0.20);
        animation:
            pimcore-orbit-tl 11s linear infinite,
            pimcore-color-pulse 6s linear 0s infinite;
    }
    #app-preloader .background-figure--bottom-left {
        width: 651.152px;
        height: 1503.398px;
        border-radius: 1503.398px;
        background: #FDFFFF;
        animation:
            pimcore-orbit-bl 9s linear infinite,
            pimcore-color-pulse 6s linear -2s infinite;
    }
    #app-preloader .background-figure--bottom-right {
        width: 1642px;
        height: 686px;
        border-radius: 1642px;
        background: color-mix(in srgb, var(--pimcore-brand-color) 42%, transparent);
        animation:
            pimcore-orbit-br 14s linear infinite,
            pimcore-color-pulse 6s linear -4s infinite;
    }

    /* Orbit keyframes — same geometry as the React Background component */
    @keyframes pimcore-orbit-tl {
        from { transform: translate(-50%, -50%) rotate(0deg)   translateX(340px); }
        to   { transform: translate(-50%, -50%) rotate(360deg) translateX(340px); }
    }
    @keyframes pimcore-orbit-bl {
        from { transform: translate(-50%, -50%) rotate(120deg) translateX(220px); }
        to   { transform: translate(-50%, -50%) rotate(480deg) translateX(220px); }
    }
    @keyframes pimcore-orbit-br {
        from { transform: translate(-50%, -50%) rotate(240deg) translateX(400px); }
        to   { transform: translate(-50%, -50%) rotate(600deg) translateX(400px); }
    }

    /* Default colour pulse — uses the hardcoded default brand colour as a literal
       so the browser can smoothly interpolate between keyframe values.
       Overridden below if branding.brandColor is provided. */
    @keyframes pimcore-color-pulse {
        0%   { background: color-mix(in srgb, #7a3ad4 42%, transparent); }
        50%  { background: rgba(55, 217, 243, 0.20); }
        100% { background: color-mix(in srgb, #7a3ad4 42%, transparent); }
    }

    #app-preloader .preloader-logo-wrap {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1;
    }
    #app-preloader .preloader-logo-wrap::before {
        content: '';
        position: absolute;
        inset: -80px -100px;
        background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0) 70%);
        pointer-events: none;
        animation: pimcore-logo-glow 7s ease-in-out infinite;
    }
    #app-preloader .preloader-logo {
        position: relative;
        display: block;
        max-width: 586px;
        max-height: 373px;
    }
    @keyframes pimcore-logo-glow {
        0%   { opacity: 0.55; }
        50%  { opacity: 0.90; }
        100% { opacity: 0.55; }
    }
</style>

{% if branding.brandColor %}
{# Override the colour-pulse keyframe with the actual brand colour as a literal value.
   A later @keyframes with the same name overrides the earlier one — last wins.
   Literal colour values (not CSS variables) are required for smooth CSS animation
   interpolation without @property registration. #}
<style>
    @keyframes pimcore-color-pulse {
        0%   { background: color-mix(in srgb, {{ branding.brandColor }} 42%, transparent); }
        50%  { background: rgba(55, 217, 243, 0.20); }
        100% { background: color-mix(in srgb, {{ branding.brandColor }} 42%, transparent); }
    }
</style>
{% endif %}

<div id="app-preloader"{% if branding.brandColor %} style="--pimcore-brand-color: {{ branding.brandColor }}; --pimcore-brand-background-color: {{ branding.brandColor }}"{% endif %}>
    <div class="background-figure background-figure--bottom-left"></div>
    <div class="background-figure background-figure--bottom-right"></div>
    <div class="background-figure background-figure--top-left"></div>
    <div class="preloader-logo-wrap">
        <img
            class="preloader-logo"
            src="{{ branding.logoUrl ?? '/bundles/pimcorestudioui/img/logo-purple.svg' }}"
            alt="Logo"
        />
    </div>
</div>
